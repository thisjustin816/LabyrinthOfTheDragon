#!/usr/bin/env node

const { execFileSync } = require('child_process');
const fs = require('fs');

/**
 * Writes src/version.h with the version the file screen shows. The Makefile
 * passes its VERSION, the major and minor version, and this adds the patch: the
 * number of commits since that line of the Makefile last changed, so every
 * build of a commit gets the same number wherever it runs. A release build
 * shows the version as is, such as "v1.1.4", and any other build adds a "+",
 * as in "v1.1.4+", so a test build can't pass for a release. Counting needs the
 * history back to that change, so in a shallow clone or outside git a test
 * build leaves the patch out and a release build stops. With no VERSION the
 * version is empty and the screen shows none. The header is only rewritten
 * when the version changes, since every object depends on it.
 *
 * Usage: version2h [major.minor] [--release]
 */
const file = 'src/version.h';
const args = process.argv.slice(2);
const release = args.includes('--release');
const base = args.find((arg) => !arg.startsWith('--'));

/** A git command's output, or null if it fails. */
function git(...command) {
  try {
    return execFileSync('git', command, {
      encoding: 'utf8',
      stdio: ['ignore', 'pipe', 'ignore'],
    }).trim();
  } catch {
    return null;
  }
}

/**
 * The number of commits since the Makefile's VERSION line last changed, or
 * null without the history to count them. A change not yet committed counts
 * as 0, since no commit has come after it.
 */
function patch() {
  if (git('rev-parse', '--is-shallow-repository') !== 'false') return null;
  const blame = git(
    'blame', '--porcelain', '-L', '/^VERSION *=/,+1', '--', 'Makefile');
  if (!blame) return null;
  const commit = blame.split(' ')[0];
  if (/^0+$/.test(commit)) return 0;
  const count = git('rev-list', '--count', `${commit}..HEAD`);
  return count === null ? null : Number(count);
}

let version = '';
if (base) {
  const n = patch();
  if (n === null && release) {
    console.error(
      'version2h: a release build needs the git history back to the ' +
      "Makefile's last change to VERSION.");
    process.exit(1);
  }
  version = `v${base}${n === null ? '' : `.${n}`}${release ? '' : '+'}`;
} else if (release) {
  console.error('version2h: a release build needs a VERSION.');
  process.exit(1);
}

const contents = [
  '/* version.h - This file is automatically generated by the version2h script */',
  '#ifndef _VERSION_H',
  '#define _VERSION_H',
  '',
  `#define GAME_VERSION "${version}"`,
  '',
  '#endif',
  '',
].join('\n');

if (fs.existsSync(file) && fs.readFileSync(file, 'utf8') === contents) {
  console.log(`'${file}' is up to date`);
} else {
  console.log(`Writing '${file}' (${version || 'no version'})`);
  fs.writeFileSync(file, contents);
}
